{
  "name": "lingowild",
  "version": "1.0.0",
  "private": true,
  "description": "LingoWild - 2D creature-taming RPG with contextual English acquisition on the web",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate:assets": "node --experimental-strip-types scripts/generate-assets.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "node --experimental-strip-types scripts/lint-project.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run generate:assets && npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.15.21",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
